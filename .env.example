# --- LLM ---
ANTHROPIC_API_KEY=
# Model routing: cheap model for triage/judging, strong model for investigation/reporting
TRIAGE_MODEL=claude-haiku-5-5
INVESTIGATOR_MODEL=claude-opus-5-5
REPORTER_MODEL=claude-opus-5-5
JUDGE_MODEL=claude-haiku-5-5

# --- LangSmith tracing (free tier: https://smith.langchain.com) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=fraud-investigator

# --- Infra (matches docker-compose.yml) ---
KAFKA_BOOTSTRAP=localhost:19092
PG_DSN=postgresql://fraud:fraud@localhost:5433/fraud
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=fraudgraph
REDIS_URL=redis://localhost:6379/0
API_URL=http://localhost:8000
